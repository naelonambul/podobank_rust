# 복사해서 backend/.env 로 쓴다. .env 는 git에 올리지 않는다.
# 실행 전에 셸에 불러온다: set -a; source backend/.env; set +a

MARIADB_URL=mysql+pymysql://podobank:change-me@127.0.0.1:3306/podobank
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=podobank
# 이벤트 로그 파일. FastAPI를 2대 띄우면 서버마다 다르게 준다(api-1.log, api-2.log)
EVENT_LOG_PATH=./var/log/app.log
# 이벤트의 instance 칸에 들어갈 서버 이름(api-1, api-2)
INSTANCE_NAME=api
# HTTPS로 배포하면 true
COOKIE_SECURE=false
# 카카오 개발자 사이트 > 앱 > 앱 키(플랫폼 키)의 REST API 키
KAKAO_CLIENT_ID=여기에_REST_API_키
# 카카오 로그인 > 보안(클라이언트 시크릿)에서 만든 코드. 활성화 "사용함"
KAKAO_CLIENT_SECRET=여기에_Client_Secret
# 카카오 로그인 > 리다이렉트 URI에 등록한 주소와 똑같이. 배포할 때는 https://도메인/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:8080/auth/kakao/callback

# 직원 계정 자동 준비: 아래 세 항목을 입력하세요. 비밀번호는 8자 이상입니다.
EMPLOYEE_PHONE_NUMBER=01000000000
EMPLOYEE_PASSWORD=change-me-employee-password
EMPLOYEE_NAME="Example Employee"
