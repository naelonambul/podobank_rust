apiVersion: 1
datasources:
  - name: Prometheus
    uid: podobank-prometheus
    type: prometheus
    access: proxy
    url: http://{{ hostvars[groups['prometheus'][0]].ansible_host }}:9090
    isDefault: true
    editable: false
    version: 1
  - name: Loki
    uid: podobank-loki
    type: loki
    access: proxy
    url: http://{{ hostvars[groups['loki'][0]].ansible_host }}:3100
    editable: false
    version: 1
